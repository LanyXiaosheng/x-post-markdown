# Install as /etc/xmd/xmd.env (root:xmd 0640); this file contains no credentials.
XMD_STATE_DIR=/var/lib/xmd
XMD_PRICE_CENTS=2990
XMD_PUBLIC_BASE_URL=https://lanyxiaosheng.cloud/xmd-api/v1
XMD_PAYMENTS_ENABLED=false
# Chrome extension origins only. May replace wildcard with exact compiled extension origin.
XMD_CORS_ORIGINS=chrome-extension://*

# Leave ALL merchant fields empty until the merchant's official credentials are installed.
XMD_WECHAT_APP_ID=
XMD_WECHAT_MCH_ID=
XMD_WECHAT_CERT_SERIAL=
XMD_WECHAT_PRIVATE_KEY_FILE=
XMD_WECHAT_PUBLIC_KEY_ID=
XMD_WECHAT_PUBLIC_KEY_FILE=
XMD_WECHAT_API_V3_KEY_FILE=
XMD_ALIPAY_APP_ID=
XMD_ALIPAY_SELLER_ID=
XMD_ALIPAY_PRIVATE_KEY_FILE=
XMD_ALIPAY_PUBLIC_KEY_FILE=
