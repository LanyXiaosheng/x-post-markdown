[Unit]
Description=XMD activation and verified payment service
After=network.target

[Service]
Type=simple
User=xmd
Group=xmd
WorkingDirectory=/opt/xmd-license/backend
EnvironmentFile=/etc/xmd/xmd.env
ExecStart=/opt/xmd-license/venv/bin/python -m xmd.server --port 8219
StateDirectory=xmd
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xmd
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
