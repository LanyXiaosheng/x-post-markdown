{
  "manifest_version": 3,
  "name": "XMD · 帖子归档",
  "version": "0.3.4",
  "description": "一键把当前 X 帖子导出为本地 Markdown 文件。",
  "permissions": ["activeTab", "contextMenus", "downloads", "storage"],
  "host_permissions": [
    "https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*",
    "https://lanyxiaosheng.cloud/xmd-api/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png"
    },
    "default_title": "导出当前 X 帖子",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["src/markdown.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "export-current-post": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "导出当前 X 帖子为 Markdown"
    }
  }
}
